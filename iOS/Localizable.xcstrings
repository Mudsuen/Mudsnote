    "attachment.maximum_count.format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add up to %lld attachments per memo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每条记录最多添加 %lld 个附件。"
          }
        }
      }
    },
    "attachment.maximum_size.format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This attachment exceeds the %lld MB limit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该附件超过 %lld MB 上限。"
          }
