#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

usage() {
  echo "Usage: ./scripts/verify [macos|ios|both] {pr|full|live}" >&2
}

case "${1:-}" in
  macos|ios|both)
    PLATFORM_SCOPE="$1"
    MODE="${2:-}"
    EXPLICIT_SCOPE=1
    ;;
  pr|full|live)
    MODE="$1"
    if [[ -n "${MUDSNOTE_PLATFORM_SCOPE:-}" ]]; then
      PLATFORM_SCOPE="$MUDSNOTE_PLATFORM_SCOPE"
      EXPLICIT_SCOPE=1
    else
      PLATFORM_SCOPE="$(./scripts/detect_platform_scope.sh)"
      EXPLICIT_SCOPE=0
    fi
    ;;
  *)
    usage
    exit 2
    ;;
esac

if [[ "$MODE" != "pr" && "$MODE" != "full" && "$MODE" != "live" ]]; then
  usage
  exit 2
fi

if [[ "$PLATFORM_SCOPE" != "macos" && "$PLATFORM_SCOPE" != "ios" && "$PLATFORM_SCOPE" != "both" && "$PLATFORM_SCOPE" != "none" ]]; then
  echo "ERROR: invalid Mudsnote platform scope: $PLATFORM_SCOPE" >&2
  usage
  exit 2
fi

if [[ "$MODE" == "live" && "$EXPLICIT_SCOPE" != "1" ]]; then
  echo "ERROR: live verification requires an explicit platform." >&2
  echo "Use './scripts/verify macos live', './scripts/verify ios live', or './scripts/verify both live'." >&2
  exit 2
fi

check_diff() {
  local base_ref=""
  if [[ -n "${GITHUB_BASE_REF:-}" ]]; then
    git fetch origin "$GITHUB_BASE_REF" --depth=1
    base_ref="origin/$GITHUB_BASE_REF"
  elif git show-ref --verify --quiet refs/remotes/origin/main; then
    base_ref="origin/main"
  fi

  if [[ -n "$base_ref" ]]; then
    local base
    base="$(git merge-base HEAD "$base_ref")"
    git diff --check "$base..HEAD"
  fi
  git diff --check
  git diff --cached --check
}

check_ci_boundary() {
  if git ls-files | grep -E '(^|/)(\.env($|\.)|[^/]+\.(sqlite|sqlite3|db|pem|p8|p12|key|mobileprovision)$|\.netrc$|id_rsa$|id_ed25519$)'; then
    echo "ERROR: tracked credential or database-like files violate the PR CI boundary." >&2
    return 1
  fi
}

check_diff
check_ci_boundary
./scripts/agent_context.sh --check

echo "Mudsnote verification scope: $PLATFORM_SCOPE ($MODE)"
case "$PLATFORM_SCOPE" in
  macos)
    ./scripts/verify_macos.sh "$MODE"
    ;;
  ios)
    ./scripts/verify_ios.sh "$MODE"
    ;;
  both)
    ./scripts/verify_macos.sh "$MODE"
    ./scripts/verify_ios.sh "$MODE"
    ;;
  none)
    if [[ "$MODE" == "live" ]]; then
      echo "ERROR: documentation-only changes have no live installation target." >&2
      exit 2
    fi
    echo "No platform source changes detected; policy checks passed."
    ;;
esac
